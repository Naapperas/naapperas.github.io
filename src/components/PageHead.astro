---
interface Props {
  title: string;
  intro?: string;
  /** Trailing character after the title, in the accent colour. */
  suffix?: string;
}

const { title, intro, suffix = '/' } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-8 pt-14 pb-6">
  <div>
    <h1 class="font-mono text-[clamp(2.2rem,5vw,3.4rem)] leading-none font-bold tracking-[-0.05em]">
      {title}<span class="text-accent">{suffix}</span>
    </h1>
    {intro && <p class="mt-2.5 max-w-xl text-muted">{intro}</p>}
    <slot />
  </div>
  <slot name="aside" />
</div>
