---
import { splitLines, splitList } from '../lib/cv';

interface Props {
  when?: string;
  details?: string | null;
  stack?: string | null;
  /** One of several roles under an organisation heading. */
  nested?: boolean;
}

const { when, details, stack, nested } = Astro.props;
const bullets = splitLines(details);
const tags = splitList(stack);
---

<div class:list={['break-inside-avoid', nested && 'border-l-2 border-border pl-3.5']}>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h4 class="font-semibold"><slot /></h4>
    {when && <span class="font-mono text-xs whitespace-nowrap text-muted">{when}</span>}
  </div>
  {
    bullets.length > 0 && (
      <ul class="mt-1 list-disc space-y-1 pl-[1.1rem] text-[0.93rem] text-muted">
        {bullets.map((b) => <li>{b}</li>)}
      </ul>
    )
  }
  {tags.length > 0 && <div class="mt-2 flex flex-wrap gap-1">{tags.map((s) => <span class="tag">{s}</span>)}</div>}
</div>
