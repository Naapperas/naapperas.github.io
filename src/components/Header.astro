---
import Moon from '../icons/moon.svg';
import Sun from '../icons/sun.svg';

interface Props {
  blog: boolean;
  contact: boolean;
}

const { blog, contact } = Astro.props;

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/projects', label: 'projects' },
  { href: '/cv', label: 'cv' },
  // Kept out of prerendering so Turnstile only runs on a page someone opened.
  ...(contact ? [{ href: '/contact', label: 'contact', prefetch: false }] : []),
  ...(blog ? [{ href: '/blog', label: 'blog' }] : []),
];
---

<header class="sticky top-0 z-20 border-b border-border bg-bg/85 backdrop-blur-md print:hidden">
  <div class="wrap flex h-14 items-center justify-between gap-2 font-mono text-[0.8rem] sm:gap-4 sm:text-[0.85rem]">
    <a href="/" class="min-w-0 truncate font-semibold text-accent" aria-label="Nuno Pereira">
      ~<span class="max-sm:hidden">{here === '/' ? '' : here}</span>
    </a>
    <nav aria-label="Main" class="flex min-w-0 items-center gap-2 sm:gap-3 md:gap-5">
      <div class="flex min-w-0 items-center gap-2.5 overflow-x-auto py-1 [scrollbar-width:none] sm:gap-3 md:gap-5">
        {
          nav.map(({ href, label, prefetch }) => (
            <a
              href={href}
              data-astro-prefetch={prefetch === false ? 'false' : undefined}
              aria-current={here === href || here.startsWith(`${href}/`) ? 'page' : undefined}
              class="shrink-0 text-muted transition-colors hover:text-text aria-[current=page]:text-accent md:before:opacity-45 md:before:content-['./']"
            >
              {label}
            </a>
          ))
        }
      </div>
      <button
        data-mode-toggle
        aria-label="Toggle light/dark theme"
        title="Toggle light/dark theme"
        class="inline-flex h-8 min-w-8 cursor-pointer items-center justify-center rounded-md border border-border bg-surface px-2 text-xs text-muted no-js:hidden hover:border-accent/50 hover:text-text"
      >
        <Sun class="hidden size-4 dark:block" /><Moon class="size-4 dark:hidden" />
      </button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const system = matchMedia('(prefers-color-scheme: dark)');
  const setMode = (mode: string) => {
    const apply = () => (root.dataset.mode = mode);
    if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(apply);
    else apply();
  };
  document.querySelector('[data-mode-toggle]')!.addEventListener('click', () => {
    const next = root.dataset.mode === 'dark' ? 'light' : 'dark';
    // Choosing what the OS already uses means "follow the OS" again.
    if (next === (system.matches ? 'dark' : 'light')) localStorage.removeItem('mode');
    else localStorage.setItem('mode', next);
    setMode(next);
  });
  system.addEventListener('change', (e) => {
    if (!localStorage.getItem('mode')) setMode(e.matches ? 'dark' : 'light');
  });
</script>
