---
import { getEmDashEntry } from 'emdash';
import { getSite } from '../../../lib/site';
import Post from '../../../views/Post.astro';

const [{ options }, { entry, cacheHint, isPreview }] = await Promise.all([
  getSite(Astro),
  getEmDashEntry('posts', Astro.params.slug!, { locale: Astro.currentLocale }),
]);
// Previews still render while the blog is hidden, so posts can be checked before it goes public.
if (!entry || (!options?.blog_enabled && !isPreview)) return Astro.rewrite('/pt/404');
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Post entry={entry} />
