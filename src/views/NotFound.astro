---
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';

Astro.response.status = 404;
---

<Base title="not found" noindex>
  <div class="wrap">
    <PageHead title="404: not found" intro="That page doesn't exist, or it moved." suffix="">
      <a class="btn primary mt-6" href="/">home</a>
    </PageHead>
  </div>
</Base>
