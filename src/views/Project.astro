---
import type { ContentEntry } from 'emdash';
import { Image, PortableText } from 'emdash/ui';
import type { Project } from '../../emdash-env';
import External from '../icons/external.svg';
import GitHub from '../icons/github.svg';
import { useI18n } from '../i18n';
import Base from '../layouts/Base.astro';
import { getTranslatedPaths } from '../lib/site';

interface Props {
  entry: ContentEntry<Project>;
}

const { entry } = Astro.props;
const { edit, data: p } = entry;
const { t, path } = useI18n(Astro.currentLocale);
const alternates = await getTranslatedPaths('projects', p.id, '/projects');
const host = (url?: string) => url?.replace(/^https?:\/\//, '').replace(/\/$/, '');
const course = [p.course_name && `${p.course_name}${p.course_code ? ` (${p.course_code})` : ''}`, [p.academic_year, p.semester && `${t('project.semester')} ${p.semester}`].filter(Boolean).join(' · ')];
---

<Base
  title={p.title}
  description={p.summary}
  type="article"
  content={{ collection: 'projects', id: p.id, slug: p.slug }}
  alternates={alternates}
>
  <div class="wrap">
    <div class="pt-10 font-mono text-[0.85rem] text-muted">
      <a href={path('/projects')} class="hover:text-accent">~/projects</a>/<span class="text-accent">{p.slug}</span>
    </div>
    <div class="grid items-start gap-8 pt-6 lg:grid-cols-[1fr_20rem]">
      <div>
        <h1 class="mt-2 font-mono text-[clamp(2rem,4.5vw,3rem)] leading-[1.05] font-bold tracking-[-0.05em]" {...edit.title}>{p.title}</h1>
        <p class="mt-3 mb-6 max-w-[46rem] text-lg text-muted" {...edit.summary}>{p.summary}</p>
        {
          p.featured_image?.id && (
            <div class="win">
              <div class="bar">
                <span class="flex-1 truncate">{host(p.live_url ?? p.repo_url) ?? p.slug}</span>
                {p.live_url && <a class="link" href={p.live_url}>{t('project.open')}</a>}
              </div>
              <div {...edit.featured_image}>
                <Image image={p.featured_image} width={1200} sizes="(max-width: 1024px) 100vw, 800px" priority class="w-full" />
              </div>
            </div>
          )
        }
        <div class="prose mt-8" {...edit.content}><PortableText value={p.content ?? []} /></div>
      </div>
      <aside class="flex flex-col gap-4 lg:sticky lg:top-18">
        <div class="win">
          <div class="bar"><span class="flex-1 truncate"><b>stat</b> {p.slug}</span></div>
          <dl class="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-2 p-4 text-[0.88rem]">
            <dt class="pt-0.5 font-mono text-[0.72rem] text-muted">{t('project.year')}</dt>
            <dd>{p.year}</dd>
            <dt class="pt-0.5 font-mono text-[0.72rem] text-muted">{t('project.type')}</dt>
            <dd>{t(`project.kind.${p.kind}`)}</dd>
            {
              course[0] && (
                <>
                  <dt class="pt-0.5 font-mono text-[0.72rem] text-muted">{t('project.course')}</dt>
                  <dd>
                    {course[0]}
                    {course[1] && (
                      <>
                        <br />
                        <span class="text-muted">{course[1]}</span>
                      </>
                    )}
                  </dd>
                </>
              )
            }
            {
              p.grade != null && (
                <>
                  <dt class="pt-0.5 font-mono text-[0.72rem] text-muted">{t('project.grade')}</dt>
                  <dd>{p.grade}/20</dd>
                </>
              )
            }
            {
              p.stack && p.stack.length > 0 && (
                <>
                  <dt class="pt-0.5 font-mono text-[0.72rem] text-muted">{t('project.stack')}</dt>
                  <dd class="flex flex-wrap gap-1">{p.stack.map((s) => <span class="tag">{s}</span>)}</dd>
                </>
              )
            }
          </dl>
        </div>
        {
          p.team && p.team.length > 0 && (
            <div class="win">
              <div class="bar"><span class="flex-1 truncate"><b>git shortlog</b> -sn <span class="sr-only">· {t('project.team')}</span></span></div>
              <ul class="flex flex-col gap-2 px-4 pt-3 pb-4 text-[0.9rem]">
                {p.team.map((m) => (
                  <li>
                    {m.github_url ? (
                      <a href={m.github_url} class="flex items-center gap-2 hover:text-accent"><GitHub class="icon" />{m.name}</a>
                    ) : (
                      <span>{m.name}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="flex flex-wrap gap-2">
          {p.repo_url && <a class="btn" href={p.repo_url}><GitHub class="icon" />{t('project.source')}</a>}
          {p.live_url && <a class="btn primary" href={p.live_url}><External class="icon" />{t('project.live')}</a>}
        </div>
      </aside>
    </div>
  </div>
</Base>
