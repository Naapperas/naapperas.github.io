---
import PageHead from '../components/PageHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { useI18n } from '../i18n';
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/projects';

const { t } = useI18n(Astro.currentLocale);
const projects = await getProjects(Astro);
const kinds = (['professional', 'academic', 'personal'] as const).filter((k) => projects.some((p) => p.kind === k));
const stackCounts = new Map<string, number>();
for (const s of projects.flatMap((p) => p.stack ?? [])) stackCounts.set(s, (stackCounts.get(s) ?? 0) + 1);
const stacks = [...stackCounts].filter(([, n]) => n > 1).toSorted((a, b) => b[1] - a[1]).slice(0, 8).map(([s]) => s);
---

<Base title={t('projects.title')} description={t('projects.intro')}>
  <div class="wrap">
    <PageHead title={t('projects.title')} intro={t('projects.intro')}>
      <Fragment slot="prompt">ls ~/projects <i>--format=cards</i></Fragment>
      {
        projects.length > 1 && (
          <div slot="aside" class="flex max-w-xl flex-wrap items-center gap-1.5" role="toolbar" aria-label={t('projects.filter')} data-filters hidden>
            <button class="chip" data-filter="" aria-pressed="true">--{t('projects.all')}</button>
            {kinds.length > 1 && kinds.map((k) => <button class="chip" data-filter={`kind:${k}`} aria-pressed="false">--{t(`project.kind.${k}`)}</button>)}
            {stacks.length > 0 && <span class="mx-1 h-5 w-px bg-border" />}
            {stacks.map((s) => <button class="chip" data-filter={`stack:${s}`} aria-pressed="false">{s}</button>)}
          </div>
        )
      }
    </PageHead>
    {
      projects.length > 0 ? (
        <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="project-cards">
          {projects.map((p, i) => <ProjectCard project={p} priority={i < 3} />)}
        </section>
      ) : (
        <p class="p-12 text-center font-mono text-muted">{t('projects.none')}</p>
      )
    }
    <p class="p-12 text-center font-mono text-muted" id="no-matches" hidden>{t('projects.empty')}</p>
  </div>
</Base>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  if (filters) {
    filters.hidden = false;
    const cards = [...document.querySelectorAll<HTMLElement>('#project-cards > [data-kind]')];
    filters.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;
      for (const b of filters.querySelectorAll('[data-filter]')) b.setAttribute('aria-pressed', String(b === button));
      const [type, value] = button.dataset.filter!.split(':');
      let shown = 0;
      for (const card of cards) {
        const match = !value || (type === 'kind' ? card.dataset.kind === value : card.dataset.stack!.split(' ').includes(value));
        card.hidden = !match;
        shown += Number(match);
      }
      document.getElementById('no-matches')!.hidden = shown > 0;
    });
  }
</script>
