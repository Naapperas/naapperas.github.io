            "rust"
          ],
          "repo_url": "https://github.com/Naapperas/crusterfuck",
          "title": "Crusterfuck",
          "summary": "A parser and interpreter for the Brainfuck esoteric language, written in Rust.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Crusterfuck is a parser and interpreter for Brainfuck, the esoteric programming language, written in Rust."
                }
              ]
            }
          ]
        }
      },
      {
        "id": "zon",
        "slug": "zon",
        "status": "published",
        "data": {
          "kind": "personal",
          "year": 2023,
          "stack": [
            "python"
          ],
          "repo_url": "https://github.com/Naapperas/zon",
          "live_url": "https://naapperas.github.io/zon/",
          "title": "zon",
          "summary": "zod's expressive validation, brought to Python with an API that stays close to the original.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "zon gives Python the expressive and powerful validation logic of zod, combined with the flexibility of Python. I started it to solve a quick need in a college project."
                }
              ]
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "The public APIs of the two libraries differ in places, but zon tries to stay as faithful as possible to the design decisions made by zod."
                }
              ]
            }
          ]
        }
      },
      {
