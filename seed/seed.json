      {
        "id": "sdle",
        "slug": "sdle",
        "status": "published",
        "data": {
          "kind": "academic",
          "year": 2023,
          "stack": [
            "sveltekit",
            "typescript",
            "kotlin",
            "crdt",
            "docker"
          ],
          "repo_url": "https://github.com/Naapperas/feup-sdle-proj",
          "live_url": "https://sdle.toino.pt",
          "featured_image": {
            "$media": {
              "url": "https://raw.githubusercontent.com/Naapperas/naapperas.github.io/e11d4ff75a9c74556cab550b4f1d8dbee3bfb53f/src/content/project/images/sdle.png",
              "alt": "Screenshot of the SDLE shopping list app",
              "filename": "sdle.png"
            }
          },
          "course_code": "SDLE",
          "academic_year": "2023/2024",
          "semester": "1",
          "team": [
            {
              "name": "João Pereira",
              "github_url": "https://github.com/ttoino"
            },
            {
              "name": "Mariana Rocha",
              "github_url": "https://github.com/golangis"
            }
          ],
          "title": "SDLE",
          "summary": "Local-first shopping lists you can share. They sync when you're online and keep working when you're not.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "SDLE (Smart Distributed List Engine) is a shopping list editor for creating and sharing lists with friends and family."
                }
              ]
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "The SvelteKit web app periodically syncs with a backend server whenever there is a connection. Without one, it keeps working offline: every change is persisted locally and synced as soon as you're back online."
                }
              ]
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "The backend uses CRDT-like data structures and gossip protocols to stay highly distributed and eventually consistent."
                }
              ]
            }
          ],
          "course_name": "Large Scale Distributed Systems"
        }
