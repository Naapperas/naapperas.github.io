    "projects": [
      {
        "id": "website",
        "slug": "website",
        "status": "published",
        "data": {
          "kind": "personal",
          "year": 2026,
          "stack": [
            "astro",
            "typescript",
            "cloudflare-workers",
            "emdash",
            "d1",
            "r2",
            "tailwind"
          ],
          "repo_url": "https://github.com/Naapperas/naapperas.github.io",
          "live_url": "https://naapperas.pt",
          "featured_image": {
            "$media": {
              "url": "https://raw.githubusercontent.com/Naapperas/naapperas.github.io/e11d4ff75a9c74556cab550b4f1d8dbee3bfb53f/src/content/project/images/website.png",
              "alt": "Screenshot of naapperas.pt",
              "filename": "website.png"
            }
          },
          "title": "naapperas.pt",
          "summary": "This website: Astro 7 on Cloudflare Workers, with EmDash on D1 and R2 and the admin behind Cloudflare Access.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "My personal website, rebuilt in 2026. Pages are rendered by Astro 7 on Cloudflare Workers and cached at the edge, so most visits never reach the Worker."
                }
              ]
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "text": "Content lives in EmDash, an Astro-native CMS backed by D1 and R2. Publishing a change purges only the affected pages from the cache. The admin sits behind Cloudflare Access."
                }
              ]
            }
          ]
        }
      },
      {
        "id": "crusterfuck",
        "slug": "crusterfuck",
        "status": "published",
        "data": {
          "kind": "personal",
          "year": 2024,
